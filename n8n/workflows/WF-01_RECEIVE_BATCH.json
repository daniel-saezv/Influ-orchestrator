      "name": "Firmar petición (bot)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Firma HMAC-SHA256 compatible con src/adapters/http/auth.js\nconst crypto = require('crypto');\nconst secret = $vars.INFLU_BOT_HMAC_SECRET;           // definir en n8n > Variables (nunca en el workflow)\nconst base = $vars.INFLU_BASE_URL;        // p. ej. https://influ-poc-orchestrator.<subdominio>.workers.dev\nconst item = $input.first().json;\nconst path = '/v1/batches';\nconst body = item.body;\nconst raw = body === null ? '' : JSON.stringify(body);\nconst ts = String(Math.floor(Date.now() / 1000));\nconst nonce = crypto.randomBytes(18).toString('base64url');\nconst bodyHash = crypto.createHash('sha256').update(raw).digest('hex');\nconst s = ['v1', ts, nonce, 'POST', path, bodyHash].join('\\n');\nconst sig = 'v1=' + crypto.createHmac('sha256', secret).update(s).digest('hex');\nreturn [{ json: { url: base + path, raw, headers: { 'x-influ-key-id': 'bot', 'x-influ-timestamp': ts, 'x-influ-nonce': nonce, 'x-influ-signature': sig } } }];"
      }
    },
