{
  "name": "influ-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "POC Fase 1 — sistema autónomo de producción y publicación (SIMULADA) para influencer virtual. Arquitectura hexagonal sobre Cloudflare Workers + D1 + KV.",
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs bot/*.test.mjs",
    "test:acceptance": "node tests/acceptance/run.mjs",
    "deploy:guard": "node deploy/ci-safety-guard.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "build:deploy": "node deploy/build.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "zod": "4.6.7"
  }
}
